<?xml version="1.0"?>
<robot name="omx_f_replay" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="port_name" default="/dev/ttyACM0" />
  <xacro:arg name="system_name" default="OMXFReplaySystem" />
  <xacro:arg name="use_sim" default="false" />
  <xacro:arg name="use_mock_hardware" default="false" />
  <xacro:arg name="mock_sensor_commands" default="false" />

  <xacro:include filename="$(find open_manipulator_description)/urdf/omx_f/omx_f_arm.urdf.xacro" />
  <xacro:include filename="$(find omx_replay)/ros2_control/omx_f_replay.ros2_control.xacro" />

  <link name="world"/>
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <joint name="end_effector_joint" type="fixed">
    <parent link="link5"/>
    <child link="end_effector_link"/>
    <origin xyz="0.09193 -0.0016 0" rpy="0 0 0"/>
  </joint>
  <link name="end_effector_link"/>

  <xacro:omx_f prefix="" />
  <xacro:omx_f_replay_system
    name="$(arg system_name)" prefix="" port_name="$(arg port_name)"
    use_sim="false" use_mock_hardware="false" mock_sensor_commands="false"/>
</robot>
